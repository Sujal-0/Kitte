# Kitte Archival Studio - Environment Variables

# Gmail SMTP for production email delivery (any recipient, free, 500 emails/day)
GMAIL_USER=kitte.archive@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Resend API Key for automated FutureMe email scheduling and delivery (optional fallback)
# Get a free key at https://resend.com (3,000 free emails/month)
RESEND_API_KEY=your_resend_api_key_here

# Supabase Cloud Database (for multi-year persistent time letters)
# Create a free project at https://supabase.com and run supabase_schema.sql
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
